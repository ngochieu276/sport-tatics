generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @map("created_at")
  sessions     Session[]
  tactics      Tactic[]
  groups       Group[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Tactic {
  id        String     @id
  userId    String     @map("user_id")
  sport     String     @default("badminton")
  format    String
  title         String
  notes         String     @default("")
  tags          Json
  snapshotCount Int        @default(0) @map("snapshot_count")
  createdAt     DateTime   @map("created_at")
  updatedAt     DateTime   @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots Snapshot[]
  groups    TacticGroup[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("tactics")
}

model Group {
  id        String        @id
  userId    String        @map("user_id")
  name      String
  createdAt DateTime      @map("created_at")
  updatedAt DateTime      @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tactics   TacticGroup[]

  @@index([userId, name])
  @@map("groups")
}

model TacticGroup {
  tacticId String @map("tactic_id")
  groupId  String @map("group_id")
  tactic   Tactic @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([tacticId, groupId])
  @@map("tactic_groups")
}

model Snapshot {
  id       String  @id
  tacticId String  @map("tactic_id")
  position Int
  parentId   String? @map("parent_id")
  branchKind String? @map("branch_kind")
  players    Json
  shot      Json
  coverArea Json    @map("cover_area")
  tactic   Tactic @relation(fields: [tacticId], references: [id], onDelete: Cascade)

  @@unique([tacticId, position])
  @@map("snapshots")
}
