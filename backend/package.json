{
  "name": "sporttactic-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy",
    "test": "node --env-file=.env --import tsx --test src/domain/badminton.test.ts src/domain/playback.test.ts src/app.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^2.4.3",
    "hono": "^4.13.13",
    "prisma": "^6.16.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
